{
  "name": "dsh-agentrouter-connect",
  "displayName": "DSH AgentRouter Connect",
  "description": "将 AgentRouter 聚合模型接入 DeepSeek Harness：进程内直连（零本地端口）、原生设置页、国内源站直连绕 WAF、协议择优与渠道抖动重试。",
  "version": "0.1.1",
  "author": "smartwu2003",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agentrouter",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "undici": "^6.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": ">=0.87.1 <2.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^1.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smartwu2003/dsh-agentrouter-connect.git"
  },
  "bugs": {
    "url": "https://github.com/smartwu2003/dsh-agentrouter-connect/issues"
  },
  "homepage": "https://github.com/smartwu2003/dsh-agentrouter-connect#readme"
}
